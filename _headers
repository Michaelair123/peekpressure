# Keep HTML revalidating so deployments appear promptly
/
  Cache-Control: public, max-age=0, must-revalidate

# Versioned static assets can be cached aggressively
/style.css
  Cache-Control: public, max-age=31536000, immutable
/liquid-glass.css
  Cache-Control: public, max-age=31536000, immutable
/faq-data.js
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
