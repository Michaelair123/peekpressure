# Cache the static homepage at Cloudflare's edge while keeping browsers revalidating
/
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=3600, stale-while-revalidate=86400

# Versioned static assets can be cached aggressively
/style.css
  Cache-Control: public, max-age=31536000, immutable
/liquid-glass.css
  Cache-Control: public, max-age=31536000, immutable
/faq-data.js
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable