{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peekpressure",
  "main": "worker.js",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
